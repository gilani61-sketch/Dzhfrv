{
  "$meta": {
    "name": "BookReels Design System",
    "version": "1.0.0",
    "derivedFrom": "разбор референса «Мартин Иден» (juliapolskayaa) + кинематографичная 2D-анимация",
    "updated": "2026-10-31"
  },
  "canvas": {
    "reel":     { "w": 1080, "h": 1920, "fps": 30, "safeTop": 220, "safeBottom": 420 },
    "wide":     { "w": 1920, "h": 1080, "fps": 30, "safeTop": 80,  "safeBottom": 140 },
    "square":   { "w": 1080, "h": 1080, "fps": 30, "safeTop": 120, "safeBottom": 200 }
  },
  "color": {
    "ink":        "#FFFFFF",
    "inkSoft":    "rgba(255,255,255,0.78)",
    "inkMuted":   "rgba(255,255,255,0.55)",
    "watermark":  "rgba(255,255,255,0.42)",
    "shadow":     "rgba(0,0,0,0.55)",
    "vignette":   "rgba(0,0,0,0.38)",
    "scrim":      "linear-gradient(to top, rgba(0,0,0,0.62) 0%, rgba(0,0,0,0.28) 22%, rgba(0,0,0,0) 46%)",
    "accentWarm": "#E8C9A0",
    "accentCold": "#8FB8D8",
    "cardBg":     "#0E1A24"
  },
  "type": {
    "display": {
      "family": "Jost",
      "weight": 200,
      "case": "uppercase",
      "tracking": 0.1,
      "lineHeight": 1.02,
      "note": "бесплатный аналог Futura PT Light — геометрический гротеск"
    },
    "subdisplay": { "family": "Jost", "weight": 300, "case": "none", "tracking": 0.02, "lineHeight": 1.2 },
    "caption":    { "family": "Jost", "weight": 300, "case": "uppercase", "tracking": 0.18, "lineHeight": 1.3 },
    "punch":      { "family": "Inter", "weight": 700, "case": "uppercase", "tracking": 0.0, "lineHeight": 1.15,
                    "note": "стиль референса №3 — пословные хардсабы для динамичных/объясняющих роликов" },
    "editorial":  { "family": "Cormorant Garamond", "weight": 300, "case": "none", "tracking": 0.01, "lineHeight": 1.25,
                    "note": "для рубрик про живопись/биографии художников — музейная интонация" }
  },
  "scale": {
    "reel": {
      "title":    { "size": 128, "tracking": 0.1 },
      "author":   { "size": 46,  "tracking": 0.02 },
      "caption":  { "size": 40,  "tracking": 0.18 },
      "punch":    { "size": 72,  "tracking": 0.0 },
      "watermark":{ "size": 24,  "tracking": 0.22 }
    },
    "wide": {
      "title":    { "size": 104, "tracking": 0.1 },
      "author":   { "size": 38,  "tracking": 0.02 },
      "caption":  { "size": 30,  "tracking": 0.18 },
      "punch":    { "size": 58,  "tracking": 0.0 },
      "watermark":{ "size": 20,  "tracking": 0.22 }
    }
  },
  "motion": {
    "titleIn":     { "durF": 26, "blurPx": 14, "scaleFrom": 1.045, "yFrom": 18, "damping": 200, "mass": 0.9 },
    "titleOut":    { "durF": 20, "blurPx": 10 },
    "captionIn":   { "durF": 9,  "yFrom": 12 },
    "captionOut":  { "durF": 7 },
    "kenBurns":    { "zoomFrom": 1.0, "zoomTo": 1.085, "panMaxPct": 3.5 },
    "crossfade":   { "durF": 14 },
    "grainOpacity": 0.055,
    "note": "вся анимация — spring с damping 200 (без пружинистого отскока) или плавный easeInOutCubic"
  },
  "layout": {
    "reel": {
      "titleBlockY": 0.46,
      "captionBaselineFromBottom": 300,
      "watermarkPos": { "x": 56, "y": 150 },
      "sideMargin": 96
    },
    "wide": {
      "titleBlockY": 0.52,
      "captionBaselineFromBottom": 96,
      "watermarkPos": { "x": 40, "y": 34 },
      "sideMargin": 120
    }
  },
  "audio": {
    "voiceLufs": -16,
    "musicLufs": -26,
    "duckDb": -9,
    "masterLufs": -14,
    "truePeak": -1.0
  }
}
